# Admin panel environment variables
# Copy this file to `.env` in the same directory.

# Backend API URL — the NestJS server the admin panel talks to.
# Local dev: http://localhost:3000
# Production: https://lms-api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Public web frontend URL — used to build "view live" links in the admin.
# Local dev: http://localhost:3001
# Production: https://yourdomain.com
NEXT_PUBLIC_WEB_URL=http://localhost:3001
