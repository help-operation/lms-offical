# # Web frontend environment variables
# # Copy this file to `.env` in the same directory.

# # Backend API URL — the NestJS server the web app talks to.
# # Local dev: http://localhost:3000
# # Production: https://lms-api.yourdomain.com
# NEXT_PUBLIC_API_URL=http://localhost:3000


===============================

# Set this in the Vercel "web" project (Production env).
# It is baked at build time — redeploy after changing it.
NEXT_PUBLIC_API_URL=https://lms-api.jashoreithub.com
