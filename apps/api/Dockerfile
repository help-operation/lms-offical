# ---- Build stage ----
FROM node:20-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 build-essential \
  && rm -rf /var/lib/apt/lists/*
RUN npm i -g pnpm@9
WORKDIR /repo

# Workspace manifests first (better layer caching)
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @repo/validators build
RUN pnpm --filter api exec nest build

# ---- Runtime stage ----
FROM node:20-slim AS runtime
RUN npm i -g pnpm@9
ENV NODE_ENV=production
# Coolify passes env vars as ARGs during build. We must promote them to
# ENV so that process.env.DATABASE_URL (etc.) is available at runtime.
# NOTE: Coolify injects ARG lines BEFORE this block in the Final Dockerfile.
ARG DATABASE_URL
ARG CORS_ORIGINS
ARG COOKIE_DOMAIN
ARG ADMIN_ORIGINS
ARG FRONTEND_URL
ARG WEB_URL
ARG GOOGLE_CALLBACK_URL
ARG BULKSMSBD_SENDER_ID
ARG BULKSMSBD_API_KEY
ARG JWT_SECRET
ARG JWT_REFRESH_SECRET
ARG REVALIDATE_SECRET
ARG BUNNY_LIBRARY_ID
ARG BUNNY_API_KEY
ARG BUNNY_TOKEN_AUTH_KEY
ARG PAYSTATION_MERCHANT_ID
ARG PAYSTATION_PASSWORD
ARG EMAIL_HOST
ARG EMAIL_PORT
ARG EMAIL_USER
ARG EMAIL_PASS
ARG GOOGLE_CLIENT_ID
ARG GOOGLE_CLIENT_SECRET
ARG R2_ACCESS_KEY_ID
ARG R2_SECRET_ACCESS_KEY
ARG R2_BUCKET
ARG R2_ENDPOINT
ARG R2_URL
ARG R2_REGION
ARG MEDIA_STORAGE_DRIVER
ENV DATABASE_URL=$DATABASE_URL \
    CORS_ORIGINS=$CORS_ORIGINS \
    COOKIE_DOMAIN=$COOKIE_DOMAIN \
    ADMIN_ORIGINS=$ADMIN_ORIGINS \
    FRONTEND_URL=$FRONTEND_URL \
    WEB_URL=$WEB_URL \
    GOOGLE_CALLBACK_URL=$GOOGLE_CALLBACK_URL \
    BULKSMSBD_SENDER_ID=$BULKSMSBD_SENDER_ID \
    BULKSMSBD_API_KEY=$BULKSMSBD_API_KEY \
    JWT_SECRET=$JWT_SECRET \
    JWT_REFRESH_SECRET=$JWT_REFRESH_SECRET \
    REVALIDATE_SECRET=$REVALIDATE_SECRET \
    BUNNY_LIBRARY_ID=$BUNNY_LIBRARY_ID \
    BUNNY_API_KEY=$BUNNY_API_KEY \
    BUNNY_TOKEN_AUTH_KEY=$BUNNY_TOKEN_AUTH_KEY \
    PAYSTATION_MERCHANT_ID=$PAYSTATION_MERCHANT_ID \
    PAYSTATION_PASSWORD=$PAYSTATION_PASSWORD \
    EMAIL_HOST=$EMAIL_HOST \
    EMAIL_PORT=$EMAIL_PORT \
    EMAIL_USER=$EMAIL_USER \
    EMAIL_PASS=$EMAIL_PASS \
    GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID \
    GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET \
    R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID \
    R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY \
    R2_BUCKET=$R2_BUCKET \
    R2_ENDPOINT=$R2_ENDPOINT \
    R2_URL=$R2_URL \
    R2_REGION=$R2_REGION \
    MEDIA_STORAGE_DRIVER=$MEDIA_STORAGE_DRIVER
WORKDIR /repo
COPY --from=build /repo /repo
WORKDIR /repo/apps/api
EXPOSE 3000

CMD ["sh", "-c", "node dist/src/db/migrate.js && node dist/src/main.js"]
