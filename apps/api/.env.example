# ──────────────────────────────────────────────────────────────────────────────
# API environment variables for LOCAL DEVELOPMENT
# Copy this file to `.env` in the same directory and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# Database (REQUIRED — the API will not start without it)
DATABASE_URL=postgresql://user:password@localhost:5432/your_database_name?sslmode=disable

# Server port (optional, defaults to 3000)
PORT=3000

# Node environment
NODE_ENV=development

# Auth secrets (optional for local dev — defaults are used if unset)
# Generate strong values: openssl rand -base64 48
# JWT_SECRET=replace-with-long-random-string
# JWT_REFRESH_SECRET=replace-with-different-long-random-string

# CORS origins (optional — defaults to localhost dev ports)
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Cookie domain (optional — leave unset for localhost)
# COOKIE_DOMAIN=.yourdomain.com

# Admin origins (optional — defaults to localhost admin dev ports)
# ADMIN_ORIGINS=http://localhost:3003,http://localhost:3004

# Backend public URL (REQUIRED for production — used as bKash callback base)
# Local: http://localhost:3000   Production: https://api.leerney.com
# API_URL=http://localhost:3000

# Frontend URL (REQUIRED for production — used for post-payment redirects)
# Local: http://localhost:3001   Production: https://leerney.com
# FRONTEND_URL=http://localhost:3001

# Google OAuth (optional — for Google login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# Cloudflare R2 storage (optional — needed for file uploads)
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_URL=
# R2_REGION=auto

# Bunny Stream (optional — needed for video hosting)
# BUNNY_LIBRARY_ID=
# BUNNY_API_KEY=
# BUNNY_TOKEN_AUTH_KEY=

# BulkSMSBD (optional — needed for OTP SMS)
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=Leerney

# Email / SMTP (required for OTP emails, password reset, notifications)
# Uses standard SMTP via nodemailer. Works with Gmail, Hostinger, or any SMTP provider.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" + "Other")
#   4. Use the 16-character password below (NOT your regular Gmail password)
#
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# PayStation (optional — needed for payments)
# PAYSTATION_MERCHANT_ID=
# PAYSTATION_PASSWORD=

# Payment credential encryption (REQUIRED for payment gateways)
# Encrypts payment gateway secrets (API keys, passwords) at rest.
# Generate: openssl rand -base64 48
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
