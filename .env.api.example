# # ──────────────────────────────────────────────────────────────────────────────
# # API runtime env — copy to ".env.api" on the VPS (docker-compose reads it).
# # NEVER commit the real .env.api file.
# # ──────────────────────────────────────────────────────────────────────────────

# NODE_ENV=production
# PORT=3000

# # Postgres (Neon HTTP driver — keep DB on Neon)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/db?sslmode=require

# # Auth — generate strong random values:  openssl rand -base64 48
# JWT_SECRET=replace-with-long-random-string
# JWT_REFRESH_SECRET=replace-with-different-long-random-string

# # Cross-subdomain wiring (the important part for this domain setup)
# CORS_ORIGINS=https://lms-web.leerney.com,https://lms-admin.leerney.com
# COOKIE_DOMAIN=.leerney.com
# # Origins of the admin app. Requests from these prefer the admin cookie; all
# # other origins (the student web app) prefer the web cookie. This prevents an
# # admin session from shadowing a student checkout when both cookies share the
# # parent domain. Defaults to the admin dev ports when unset.
# ADMIN_ORIGINS=https://lms-admin.leerney.com

# # Used for payment redirect back to the storefront
# FRONTEND_URL=https://lms-web.leerney.com

# # Bunny Stream (video)
# BUNNY_LIBRARY_ID=
# BUNNY_API_KEY=
# BUNNY_TOKEN_AUTH_KEY=

# # BulkSMSBD (OTP for phone signup/login/forgot-password)
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=Leerney

# # PayStation (payments) — fill if you use it
# PAYSTATION_MERCHANT_ID=
# PAYSTATION_PASSWORD=
========================================



# ──────────────────────────────────────────────────────────────────────────────
# API runtime env — copy to ".env.api" on the VPS (docker-compose reads it).
# NEVER commit the real .env.api file.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# Postgres (Neon HTTP driver — keep DB on Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/db?sslmode=require

# Auth — generate strong random values:  openssl rand -base64 48
JWT_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string

# Cross-subdomain wiring (the important part for this domain setup)
CORS_ORIGINS=https://lms-web.jashoreithub.com,https://lms-admin.jashoreithub.com
COOKIE_DOMAIN=.jashoreithub.com
# Origins of the admin app. Requests from these prefer the admin cookie; all
# other origins (the student web app) prefer the web cookie. This prevents an
# admin session from shadowing a student checkout when both cookies share the
# parent domain. Defaults to the admin dev ports when unset.
ADMIN_ORIGINS=https://lms-admin.jashoreithub.com

# Used for payment redirect back to the storefront
FRONTEND_URL=https://lms-web.jashoreithub.com

# Bunny Stream (video)
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_AUTH_KEY=

# BulkSMSBD (OTP for phone signup/login/forgot-password)
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=Skillkoro

# Email / SMTP (required for OTP emails, password reset, notifications)
# Uses standard SMTP via nodemailer. Works with Gmail, Hostinger, or any SMTP provider.
#
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" + "Other")
#   4. Use the 16-character password below (NOT your regular Gmail password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# PayStation (payments) — fill if you use it
PAYSTATION_MERCHANT_ID=
PAYSTATION_PASSWORD=
